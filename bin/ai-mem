#!/usr/bin/env python3
"""
AI-Workspace Memory Manager (Zero-dependency CLI)
Universal multi-device, multi-model agent coordination tool.

Commands:
  ai-mem status                     Show repo git status and memory alignment
  ai-mem prompt [--tier 1|2|3]      Assemble context prompt for any LLM
  ai-mem save                       Interactively record a dated session handoff
  ai-mem log [-n N]                 View recent session handoffs for active repo
  ai-mem map                        AST & structural code mapping -> ARCHITECTURE.md
  ai-mem lock <workstream>          Register active workstream to prevent collisions
  ai-mem unlock <workstream>        Clear active workstream from CURRENT.md
  ai-mem compact [--keep N]         Archive older sessions to prevent context rot
  ai-mem init <slug>                Bootstrap and register memory for current repo
  ai-mem inject <tool>              Generate tool configs (cursor, aider, claude, copilot, all)
  ai-mem doctor                     Run workspace and project diagnostic checks
"""

import sys
import os
import subprocess
import datetime
import re
import ast
import argparse
import fcntl
import tempfile
import socket
import getpass
from contextlib import contextmanager
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
WORKSPACE = Path(os.environ.get("AI_WORKSPACE_DIR", SCRIPT_DIR.parent))
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")


def projects_file():
    """Prefer the local registry, falling back to the checked-in example."""
    local = WORKSPACE / "PROJECTS.md"
    if local.exists():
        return local
    example = WORKSPACE / "PROJECTS.md.example"
    return example if example.exists() else local

# Privacy patterns for sanitization boundary
SECRET_PATTERNS = [
    (re.compile(r"sk-[a-zA-Z0-9]{20,}"), "[REDACTED_OPENAI_KEY]"),
    (re.compile(r"ghp_[a-zA-Z0-9]{20,}"), "[REDACTED_GITHUB_TOKEN]"),
    (re.compile(r"Bearer\s+[a-zA-Z0-9\._\-]{20,}"), "Bearer [REDACTED_TOKEN]"),
    (re.compile(r"-----BEGIN [A-Z ]+ PRIVATE KEY-----[\s\S]*?-----END [A-Z ]+ PRIVATE KEY-----"), "[REDACTED_PRIVATE_KEY]"),
    (re.compile(r"(api[_-]?key\s*[:=]\s*['\"][a-zA-Z0-9_\-]{16,}['\"])", re.IGNORECASE), "api_key=[REDACTED]"),
    (re.compile(r"(?i)(password|passwd|secret)\s*[:=]\s*[^\s&]+"), r"\1=[REDACTED]"),
    (re.compile(r"(?i)(https?://[^\s/:@]+:)[^\s@/]+@"), r"\1[REDACTED]@"),
    (re.compile(r"AKIA[0-9A-Z]{16}"), "[REDACTED_AWS_ACCESS_KEY]"),
]


def sanitize_text(text):
    for pattern, replacement in SECRET_PATTERNS:
        text = pattern.sub(replacement, text)
    return text


def safe_label(value, default, limit=64):
    """Produce a filename/frontmatter-safe label without accepting path syntax."""
    value = re.sub(r"\s+", "-", value.strip().lower())
    value = re.sub(r"[^a-z0-9._-]", "-", value).strip(".-")
    value = re.sub(r"-{2,}", "-", value)[:limit]
    return value or default


def default_owner():
    return os.environ.get("AI_MEM_OWNER", "{}@{}".format(getpass.getuser(), socket.gethostname()))


def get_git_info(cwd=None):
    if cwd is None:
        cwd = Path.cwd()
    try:
        root = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(cwd),
            universal_newlines=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        commit = subprocess.check_output(
            ["git", "rev-parse", "--short", "HEAD"],
            cwd=str(cwd),
            universal_newlines=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        branch = subprocess.check_output(
            ["git", "branch", "--show-current"],
            cwd=str(cwd),
            universal_newlines=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        return Path(root), commit, branch
    except Exception:
        return Path(cwd), "uncommitted", "no-git"


def resolve_project(repo_path):
    """Resolve the most-specific registered repository ancestor."""
    registry = projects_file()
    if not registry.exists():
        return None
    matches = []
    repo_path = Path(repo_path).resolve()
    with open(str(registry)) as f:
        for line in f:
            columns = [p.strip().strip("`") for p in line.strip().split("|")[1:-1]]
            if len(columns) != 4 or columns[0] in ("Project", "---"):
                continue
            try:
                registered_path = Path(columns[1]).expanduser().resolve()
                repo_path.relative_to(registered_path)
            except ValueError:
                continue
            memory_path = Path(columns[2])
            if memory_path.is_absolute() or ".." in memory_path.parts:
                continue
            candidate = WORKSPACE / memory_path
            # A registry entry is not allowed to traverse through a symlink.  Without
            # this check, a project entry could make commands read or replace another
            # project's memory files.
            try:
                candidate.relative_to(WORKSPACE / "projects")
                if candidate.exists() and candidate.resolve() != candidate.absolute():
                    continue
            except ValueError:
                continue
            matches.append((len(registered_path.parts), candidate))
    return max(matches, key=lambda item: item[0])[1] if matches else None


def atomic_write(path, content):
    """Replace a text file atomically, preserving its existing permissions."""
    mode = path.stat().st_mode if path.exists() else None
    handle = tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", delete=False,
                                         dir=str(path.parent), prefix=".ai-mem-")
    try:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())
        handle.close()
        if mode is not None:
            os.chmod(handle.name, mode)
        os.replace(handle.name, str(path))
    finally:
        if not handle.closed:
            handle.close()
        if os.path.exists(handle.name):
            os.unlink(handle.name)


@contextmanager
def current_file_lock(current_file):
    """Serialize ai-mem lock updates using a stable adjacent lock file."""
    lock_path = current_file.with_name(current_file.name + ".lock")
    with open(str(lock_path), "a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)


@contextmanager
def file_lock(path):
    """Serialize a mutable workspace resource through a stable lock inode."""
    lock_path = path.with_name(path.name + ".lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(str(lock_path), "a+") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)


def project_classification(project_md):
    match = re.search(r"^\s*-\s*Default:\s*`?([a-z-]+)`?\s*$", project_md,
                      flags=re.IGNORECASE | re.MULTILINE)
    return match.group(1).lower() if match else "local-only"


def approved_cloud_providers(project_md):
    match = re.search(r"^\s*-\s*Approved cloud providers/models:\s*(.+)$", project_md,
                      flags=re.IGNORECASE | re.MULTILINE)
    if not match or match.group(1).strip().lower() in ("", "none", "none until explicitly recorded"):
        return []
    return [item.strip().lower() for item in match.group(1).split(",") if item.strip()]


def cmd_prompt(tier=1, route="local", provider=None):
    repo_path, commit, branch = get_git_info()
    proj_dir = resolve_project(repo_path)

    # 1. Header
    print("<!-- AI-MEMORY-START -->")
    print("Git-Context: {} | Branch: {} | Commit: {}".format(repo_path.name, branch, commit))

    global_md = WORKSPACE / "GLOBAL.md"
    if not global_md.exists() and (WORKSPACE / "GLOBAL.md.example").exists():
        global_md = WORKSPACE / "GLOBAL.md.example"
    if global_md.exists():
        print("\n# Global Environment Rules\n{}".format(sanitize_text(global_md.read_text().strip())))

    if not proj_dir or not proj_dir.exists():
        print("\n[Notice: Repository {} is not registered in PROJECTS.md]".format(repo_path))
        print("<!-- AI-MEMORY-END -->\n")
        return

    # 2. Tiered context assembly
    project_md = (proj_dir / "PROJECT.md").read_text().strip() if (proj_dir / "PROJECT.md").exists() else ""
    current_md = (proj_dir / "CURRENT.md").read_text().strip() if (proj_dir / "CURRENT.md").exists() else ""
    decisions_md = (proj_dir / "DECISIONS.md").read_text().strip() if (proj_dir / "DECISIONS.md").exists() else ""

    classification = project_classification(project_md)
    if route == "cloud":
        if classification not in ("public", "cloud-approved"):
            print("Error: Project classification '{}' cannot be emitted for a cloud route.".format(classification), file=sys.stderr)
            sys.exit(3)
        if classification == "cloud-approved":
            approved = approved_cloud_providers(project_md)
            if not provider or provider.lower() not in approved:
                print("Error: Cloud route requires an explicitly approved --provider for this project.", file=sys.stderr)
                sys.exit(3)

    # Prompt output crosses a model boundary. Redact known credential forms from
    # every memory document before it leaves this process.
    project_md, current_md, decisions_md = [sanitize_text(value) for value in
                                            (project_md, current_md, decisions_md)]
    if tier == 3:  # Fast / Edge (Local 7B/14B)
        print("\n# Active Project: {}\n## Immediate State\n{}".format(proj_dir.name, current_md))
    elif tier == 2:  # Mid-Weight (Local 32B/70B)
        print("\n# Project Charter\n{}\n\n# Current State\n{}".format(project_md, current_md))
    else:  # Tier 1: Full Frontier
        print("\n# Project Charter\n{}\n\n# Current State\n{}\n\n# Key Decisions\n{}".format(project_md, current_md, decisions_md))

    print("<!-- AI-MEMORY-END -->\n")


def cmd_save():
    repo_path, commit, branch = get_git_info()
    proj_dir = resolve_project(repo_path)
    if not proj_dir:
        print("Error: Current directory {} is not registered in PROJECTS.md".format(repo_path))
        sys.exit(1)

    print("--- Session Recording for {} ---".format(proj_dir.name))
    try:
        agent = safe_label(input("Agent/Tool (e.g. cursor, ollama, claude, aider, script) [agent]: "), "agent")
        model = safe_label(input("Model (e.g. qwen2.5-32b, deepseek-r1, sonnet, gemini) [unknown]: "), "unknown")
        task = safe_label(input("Short task description: "), "session")
    except EOFError:
        print("Error: Session recording cancelled (input closed).", file=sys.stderr)
        sys.exit(2)

    timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    session_id = "{}-{}-{}".format(timestamp, agent, task)

    template = """---
project: {project}
session_id: {session_id}
date: {date}
agent: {agent}
model: {model}
branch: {branch}
commit: {commit}
status: completed
---

# {title}

## Requested
<!-- What the user or pipeline requested -->

## Work Completed
<!-- Concrete actions, code changes, refactors -->

## Verification & Tests
<!-- Evidence: command outputs, test assertions, benchmark logs -->

## Decisions Made
<!-- Architectural or durable choices to copy to DECISIONS.md -->

## Next Step
<!-- The smallest useful next action -->
""".format(
        project=proj_dir.name,
        session_id=session_id,
        date=datetime.date.today().isoformat(),
        agent=agent,
        model=model,
        branch=branch,
        commit=commit,
        title=task.replace("-", " ").title(),
    )

    sessions_dir = proj_dir.joinpath("sessions")
    sessions_dir.mkdir(parents=True, exist_ok=True)
    clean_template = sanitize_text(template)
    with file_lock(sessions_dir):
        suffix = 0
        while True:
            filename = "{}.md".format(session_id if suffix == 0 else "{}-{}".format(session_id, suffix))
            session_file = sessions_dir / filename
            try:
                fd = os.open(str(session_file), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w") as handle:
                    handle.write(clean_template)
                break
            except FileExistsError:
                suffix += 1
    print("\n✅ Session handoff drafted: {}".format(session_file))
    print("👉 Edit this file to record details, and update {}/CURRENT.md".format(proj_dir))


def cmd_log(n=5):
    repo_path, commit, branch = get_git_info()
    proj_dir = resolve_project(repo_path)
    if not proj_dir:
        print("Error: Current directory is not registered in PROJECTS.md")
        sys.exit(1)

    sessions_dir = proj_dir / "sessions"
    if not sessions_dir.exists():
        print("No sessions directory found in {}".format(proj_dir))
        return

    session_files = sorted(sessions_dir.glob("*.md"), reverse=True)
    if not session_files:
        print("No session records found for {}.".format(proj_dir.name))
        return

    print("Recent {} sessions for {}:".format(min(n, len(session_files)), proj_dir.name))
    print("-" * 75)
    for sfile in session_files[:n]:
        agent, model, date, status = "unknown", "unknown", "unknown", "unknown"
        title = sfile.stem
        try:
            with open(str(sfile)) as f:
                lines = f.readlines()
                in_frontmatter = False
                for line in lines:
                    line_s = line.strip()
                    if line_s == "---":
                        in_frontmatter = not in_frontmatter
                        continue
                    if in_frontmatter and ":" in line_s:
                        k, v = line_s.split(":", 1)
                        k, v = k.strip(), v.strip()
                        if k == "agent": agent = v
                        elif k == "model": model = v
                        elif k == "date": date = v
                        elif k == "status": status = v
                    elif not in_frontmatter and line_s.startswith("# "):
                        title = line_s[2:].strip()
                        break
        except Exception:
            pass
        print("📅 {} | 🤖 {:<10} | 🧠 {:<15} | ✅ {:<10}".format(date, agent, model, status))
        print("   Task: {} ({})".format(title, sfile.name))
        print("-" * 75)


def cmd_compact(keep=5):
    """Inspired by ai-memory: decay/archive older cold sessions to prevent context rot."""
    repo_path, _, _ = get_git_info()
    proj_dir = resolve_project(repo_path)
    if not proj_dir:
        print("Error: Must be in a registered repository.")
        sys.exit(1)
    if keep < 0:
        print("Error: --keep must be zero or greater.", file=sys.stderr)
        sys.exit(2)

    sessions_dir = proj_dir / "sessions"
    archive_dir = sessions_dir / "archive"
    if not sessions_dir.exists():
        print("No sessions directory found.")
        return

    with file_lock(sessions_dir):
        all_sessions = sorted(sessions_dir.glob("*.md"), reverse=True)
        if len(all_sessions) <= keep:
            print("✅ Session count ({}) <= threshold ({}). No compaction needed.".format(len(all_sessions), keep))
            return
        to_archive = all_sessions[keep:]
        archive_dir.mkdir(parents=True, exist_ok=True)
        collisions = [str(archive_dir / item.name) for item in to_archive if (archive_dir / item.name).exists()]
        if collisions:
            print("Error: Refusing compaction because archive targets already exist: {}".format(
                ", ".join(collisions)), file=sys.stderr)
            sys.exit(1)
        for sfile in to_archive:
            os.replace(str(sfile), str(archive_dir / sfile.name))
        archived_count = len(to_archive)

    print("==========================================================")
    print("              AI-Workspace Memory Compaction              ")
    print("==========================================================")
    print("Project:           {}".format(proj_dir.name))
    print("Active Sessions:   {} (kept in {})".format(keep, sessions_dir))
    print("Archived Sessions: {} (moved to {})".format(archived_count, archive_dir))
    print("✅ Context rot mitigated: active sessions directory is clean.")
    print("==========================================================")


def cmd_lock(workstream, agent=None, scope="active work"):
    """Register a workstream without corrupting the CURRENT.md lock table."""
    repo_path, commit, branch = get_git_info()
    proj_dir = resolve_project(repo_path)
    if not proj_dir:
        print("Error: Must be in a registered repository.")
        sys.exit(1)

    current_file = proj_dir / "CURRENT.md"
    if not current_file.exists():
        print("Error: CURRENT.md not found in {}".format(proj_dir))
        sys.exit(1)

    if not workstream.strip() or "|" in workstream or "\n" in workstream:
        print("Error: Workstream must be non-empty and cannot contain '|' or a newline.")
        sys.exit(2)

    owner = agent or default_owner()
    if any(value in owner for value in ("|", "\n")) or any(value in scope for value in ("|", "\n")):
        print("Error: Lock owner and scope cannot contain '|' or a newline.")
        sys.exit(2)
    lock_entry = "| {} | — | {} | {} | {} | In-Progress |\n".format(
        workstream.strip(), owner, branch or "detached", scope
    )
    with current_file_lock(current_file):
        lines = current_file.read_text().splitlines(True)
        rows = [line.strip().split("|")[1:-1] for line in lines if line.strip().startswith("|")]
        if any(len(row) == 6 and row[0].strip() == workstream.strip() for row in rows):
            print("⚠️  Workstream '{}' is already registered in CURRENT.md.".format(workstream))
            sys.exit(1)

        heading = next((i for i, line in enumerate(lines)
                        if line.strip().lower() == "## active workstreams"), None)
        if heading is None:
            lines.extend(["\n## Active Workstreams\n",
                          "| Workstream | Session ID | Agent/model | Branch/worktree | Scope | Status |\n",
                          "|---|---|---|---|---|---|\n"])
            insert_at = len(lines)
        else:
            separator = next((i for i in range(heading + 1, len(lines))
                              if re.match(r"^\|(?:\s*:?-{3,}:?\s*\|)+\s*$", lines[i].strip())), None)
            if separator is None:
                lines[heading + 1:heading + 1] = [
                    "| Workstream | Session ID | Agent/model | Branch/worktree | Scope | Status |\n",
                    "|---|---|---|---|---|---|\n",
                ]
                insert_at = heading + 3
            else:
                insert_at = separator + 1
        # Remove the template's placeholder row once a real lock is added.
        lines = [line for line in lines if not (line.strip().startswith("|") and
                 line.strip().split("|")[1].strip() == "None")]
        if heading is not None and separator is not None:
            insert_at = next(i + 1 for i, line in enumerate(lines)
                             if re.match(r"^\|(?:\s*:?-{3,}:?\s*\|)+\s*$", line.strip()))
        lines.insert(insert_at, lock_entry)
        atomic_write(current_file, "".join(lines))
    print("🔒 Concurrency Lock Acquired: Registered '{}' in {}/CURRENT.md".format(workstream, proj_dir.name))


def cmd_unlock(workstream, owner=None):
    """Clear active workstream from CURRENT.md."""
    repo_path, _, _ = get_git_info()
    proj_dir = resolve_project(repo_path)
    if not proj_dir:
        print("Error: Must be in a registered repository.")
        sys.exit(1)

    current_file = proj_dir / "CURRENT.md"
    if not current_file.exists():
        return

    owner = owner or default_owner()
    with current_file_lock(current_file):
        lines = current_file.read_text().splitlines(True)
        new_lines = []
        removed = False
        for line in lines:
            columns = line.strip().split("|")[1:-1] if line.strip().startswith("|") else []
            if len(columns) == 6 and columns[0].strip() == workstream:
                if columns[2].strip() != owner:
                    print("Error: Workstream '{}' belongs to '{}', not '{}'.".format(
                        workstream, columns[2].strip(), owner), file=sys.stderr)
                    sys.exit(1)
                removed = True
                continue
            new_lines.append(line)
        if removed:
            atomic_write(current_file, "".join(new_lines))
    if removed:
        print("🔓 Concurrency Lock Released: Removed '{}' from {}/CURRENT.md".format(workstream, proj_dir.name))
    else:
        print("⚠️  No workstream named '{}' was registered in CURRENT.md.".format(workstream))


def cmd_map():
    """Inspired by graphify: deterministic AST & structural codebase scanner -> ARCHITECTURE.md."""
    repo_path, commit, branch = get_git_info()
    proj_dir = resolve_project(repo_path)
    if not proj_dir:
        print("Error: Must be in a registered repository to map codebase.")
        sys.exit(1)

    print("Mapping codebase in: {} ...".format(repo_path))
    ignore_dirs = {".git", "node_modules", "__pycache__", "venv", ".venv", "dist", "build", ".next", ".cache", "target"}

    file_summary = {}
    py_symbols = {}

    for root, dirs, files in os.walk(str(repo_path), followlinks=False):
        dirs[:] = [d for d in dirs if d not in ignore_dirs and not d.startswith(".")]
        for f in files:
            if f.startswith("."): continue
            full_path = os.path.join(root, f)
            if os.path.islink(full_path):
                continue
            ext = os.path.splitext(f)[1].lower()
            rel_file = os.path.relpath(os.path.join(root, f), str(repo_path))
            file_summary[ext] = file_summary.get(ext, 0) + 1

            if ext == ".py":
                try:
                    if os.path.getsize(full_path) > 1024 * 1024:
                        continue
                    with open(full_path, "r", encoding="utf-8", errors="ignore") as py_f:
                        tree = ast.parse(py_f.read(), filename=f)
                        classes = [n.name for n in ast.walk(tree) if isinstance(n, ast.ClassDef)]
                        functions = [n.name for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and not n.name.startswith("_")]
                        if classes or functions:
                            py_symbols[rel_file] = {"classes": classes, "functions": functions[:10]}
                except Exception:
                    pass

    # Build clean ARCHITECTURE.md
    arch_file = proj_dir / "ARCHITECTURE.md"
    output = []
    output.append("# Architecture & Codebase Map")
    output.append("\nLast updated: {} | Commit: {} | Branch: {}".format(datetime.date.today().isoformat(), commit, branch))
    output.append("\n## File Inventory by Type")
    for ext, count in sorted(file_summary.items(), key=lambda x: -x[1])[:10]:
        display_ext = ext if ext else "[no-extension]"
        output.append("- `{}`: {} files".format(display_ext, count))

    if py_symbols:
        output.append("\n## Python Module & Symbol Map (AST-Derived)")
        for pfile, syms in sorted(py_symbols.items())[:30]:
            output.append("### `{}`".format(pfile))
            if syms["classes"]:
                output.append("- **Classes**: `{}`".format("`, `".join(syms["classes"])))
            if syms["functions"]:
                output.append("- **Functions**: `{}`".format("`, `".join(syms["functions"])))
            output.append("")

    output.append("\n---\n*Generated deterministically by `ai-mem map` (zero LLM token spend, no vector store required).*")

    if arch_file.is_symlink():
        print("Error: Refusing to write ARCHITECTURE.md through a symlink.", file=sys.stderr)
        sys.exit(1)
    atomic_write(arch_file, "\n".join(output) + "\n")
    print("✅ Deterministic Codebase Map written to: {}".format(arch_file))


def cmd_status():
    repo_path, commit, branch = get_git_info()
    proj_dir = resolve_project(repo_path)
    print("==========================================================")
    print("            AI-Workspace Memory Alignment Check           ")
    print("==========================================================")
    print("Repository Path:  {}".format(repo_path))
    print("Git Context:      Branch={}, Commit={}".format(branch, commit))

    if proj_dir and proj_dir.exists():
        print("Memory Directory: {}".format(proj_dir))
        print("Status:           REGISTERED & ACTIVE")
        current_md = proj_dir / "CURRENT.md"
        if current_md.exists():
            print("\nPreview of CURRENT.md:")
            for line in current_md.read_text().splitlines()[:6]:
                print("  {}".format(line))
        session_count = len(list((proj_dir / "sessions").glob("*.md"))) if (proj_dir / "sessions").exists() else 0
        archive_count = len(list((proj_dir / "sessions" / "archive").glob("*.md"))) if (proj_dir / "sessions" / "archive").exists() else 0
        print("\nSessions: {} active, {} archived".format(session_count, archive_count))
    else:
        print("Memory Directory: NOT REGISTERED")
        print("\nRun 'ai-mem init <slug>' to link this repository to the memory hub.")
    print("==========================================================")


def cmd_init(slug):
    repo_path, _, _ = get_git_info()
    if not SLUG_RE.match(slug):
        print("Error: Project slug must contain only lowercase letters, digits, and hyphens.")
        sys.exit(2)
    templates_dir = WORKSPACE / "templates"
    documents = ["PROJECT.md", "CURRENT.md", "DECISIONS.md", "EXPERIMENTS.md", "ARCHITECTURE.md", "GLOSSARY.md"]
    missing = [doc for doc in documents if not (templates_dir / doc).is_file()]
    if missing:
        print("Error: Required templates are missing: {}".format(", ".join(missing)), file=sys.stderr)
        sys.exit(1)
    target_dir = WORKSPACE / "projects" / slug
    registry_path = WORKSPACE / "PROJECTS.md"
    with file_lock(registry_path):
        if target_dir.exists():
            print("Error: Memory directory {} already exists.".format(target_dir))
            sys.exit(1)
        if not registry_path.exists():
            example = WORKSPACE / "PROJECTS.md.example"
            if not example.exists():
                print("Error: PROJECTS.md and PROJECTS.md.example are both missing.")
                sys.exit(1)
            atomic_write(registry_path, example.read_text())
        text = registry_path.read_text()
        if str(repo_path) in text:
            print("Error: Repository {} is already registered.".format(repo_path), file=sys.stderr)
            sys.exit(1)
        target_dir.joinpath("sessions").mkdir(parents=True, exist_ok=False)
        for doc in documents:
            src = templates_dir / doc
            dst = target_dir / doc
            content = src.read_text()
            content = content.replace("/absolute/path", str(repo_path))
            content = content.replace("YYYY-MM-DD", datetime.date.today().isoformat())
            atomic_write(dst, content)

        entry = "| {} | {} | projects/{} | Active |\n".format(slug.replace("-", " ").title(), repo_path, slug)
        atomic_write(registry_path, text.rstrip() + "\n" + entry)
    print("✅ Registered {} in {}".format(slug, registry_path))
    print("✅ Initialized memory directory: {}".format(target_dir))


def write_integration_file(path, content):
    """Create an integration file without overwriting a user's configuration."""
    if path.exists():
        print("⚠️  Skipped existing file (left unchanged): {}".format(path))
        return False
    path.write_text(content)
    return True


def cmd_inject(tool):
    repo_path, _, _ = get_git_info()
    proj_dir = resolve_project(repo_path)
    if not proj_dir:
        print("Error: Must be in a registered repository to inject tool configurations.")
        sys.exit(1)

    valid_tools = {"cursor", "aider", "claude", "copilot", "all"}
    if tool not in valid_tools:
        print("Error: Unknown tool '{}'. Choose cursor, aider, claude, copilot, or all.".format(tool))
        sys.exit(2)
    tools = ["cursor", "aider", "claude", "copilot"] if tool == "all" else [tool]

    if "cursor" in tools:
        rules_dir = repo_path / ".cursor" / "rules"
        rules_dir.mkdir(parents=True, exist_ok=True)
        rule_file = rules_dir / "agent-memory.mdc"
        if write_integration_file(rule_file,
            "---\ndescription: Agent memory workflow\nglobs: *\n---\n"
            "# Shared Agent Memory\n"
            "Always read `{current_md}` before modifying files.\n"
            "Follow the universal rules in `~/AGENTS.md`.\n"
            "When done, run `ai-mem save` to record the session.\n".format(
                current_md=proj_dir / "CURRENT.md"
            )):
            print("✅ Injected Cursor rule: {}".format(rule_file))

    if "aider" in tools:
        aider_conf = repo_path / ".aider.conf.yml"
        content = "read:\n  - ~/AGENTS.md\n  - {}\n".format(proj_dir / "CURRENT.md")
        if write_integration_file(aider_conf, content):
            print("✅ Injected Aider configuration: {}".format(aider_conf))

    if "claude" in tools:
        claude_md = repo_path / "CLAUDE.md"
        content = (
            "# Claude Entry Point\n\n"
            "Follow `~/AGENTS.md` and the memory workflow.\n"
            "Read `{current_md}` before acting.\n"
        ).format(current_md=proj_dir / "CURRENT.md")
        if write_integration_file(claude_md, content):
            print("✅ Injected Claude entrypoint: {}".format(claude_md))

    if "copilot" in tools:
        copilot_dir = repo_path / ".github"
        copilot_dir.mkdir(parents=True, exist_ok=True)
        copilot_file = copilot_dir / "copilot-instructions.md"
        content = (
            "# GitHub Copilot Instructions\n\n"
            "Follow `~/AGENTS.md`.\n"
            "Consult `{current_md}` for active architecture state and ongoing goals.\n"
        ).format(current_md=proj_dir / "CURRENT.md")
        if write_integration_file(copilot_file, content):
            print("✅ Injected Copilot instructions: {}".format(copilot_file))


def cmd_doctor():
    print("==========================================================")
    print("               AI-Workspace Doctor Diagnostic             ")
    print("==========================================================")
    errors = 0
    warnings = 0

    # 1. Check workspace
    if WORKSPACE.exists():
        print("✅ Workspace directory: {}".format(WORKSPACE))
    else:
        print("❌ Workspace directory missing: {}".format(WORKSPACE))
        errors += 1

    # 2. Check universal AGENTS.md
    home_agents = Path.home() / "AGENTS.md"
    if home_agents.exists():
        print("✅ Universal agent rules: {}".format(home_agents))
    else:
        print("⚠️  Warning: ~/AGENTS.md not found. Run ./install.sh or copy templates/AGENTS.md")
        warnings += 1

    # 3. Check PROJECTS.md
    registry = projects_file()
    if registry.exists():
        with open(str(registry)) as f:
            count = sum(1 for l in f if l.strip().startswith("|") and not l.strip().startswith("| Project") and not l.strip().startswith("|---"))
        print("✅ Projects registry: {} ({} projects registered)".format(registry.name, count))
    else:
        print("❌ PROJECTS.md missing in {}".format(WORKSPACE))
        errors += 1

    # 4. Check Current Repo
    repo_path, commit, branch = get_git_info()
    print("\n--- Current Directory Check ---")
    print("Directory: {}".format(repo_path))
    if branch != "no-git":
        print("✅ Git repository detected (Branch={}, Commit={})".format(branch, commit))
    else:
        print("ℹ️  Not a git repository.")

    proj_dir = resolve_project(repo_path)
    if proj_dir and proj_dir.exists():
        print("✅ Registered project memory: {}".format(proj_dir))
        for req in ["PROJECT.md", "CURRENT.md", "DECISIONS.md"]:
            if (proj_dir / req).exists():
                print("   ✅ {}".format(req))
            else:
                print("   ⚠️  Missing {}".format(req))
                warnings += 1
    else:
        print("ℹ️  Directory is not registered in PROJECTS.md.")

    print("\nDiagnostic complete: {} error(s), {} warning(s).".format(errors, warnings))
    print("==========================================================")


def non_negative(value):
    try:
        result = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("must be an integer")
    if result < 0:
        raise argparse.ArgumentTypeError("must be zero or greater")
    return result


def main(argv=None):
    parser = argparse.ArgumentParser(prog="ai-mem")
    sub = parser.add_subparsers(dest="command")
    prompt = sub.add_parser("prompt")
    prompt.add_argument("--tier", type=int, choices=(1, 2, 3), default=1)
    prompt.add_argument("--route", choices=("local", "cloud"), default="local")
    prompt.add_argument("--provider", help="provider name, required for cloud-approved projects")
    sub.add_parser("status")
    sub.add_parser("save")
    log = sub.add_parser("log")
    log.add_argument("-n", type=non_negative, default=5)
    sub.add_parser("map")
    lock = sub.add_parser("lock")
    lock.add_argument("workstream")
    lock.add_argument("--owner")
    lock.add_argument("--scope", default="active work")
    unlock = sub.add_parser("unlock")
    unlock.add_argument("workstream")
    unlock.add_argument("--owner")
    compact = sub.add_parser("compact")
    compact.add_argument("--keep", type=non_negative, default=5)
    init = sub.add_parser("init")
    init.add_argument("slug")
    inject = sub.add_parser("inject")
    inject.add_argument("tool", choices=("cursor", "aider", "claude", "copilot", "all"), default="all", nargs="?")
    sub.add_parser("doctor")
    parsed = parser.parse_args(argv)
    if parsed.command is None:
        parser.print_help(sys.stderr)
        return 2
    if parsed.command == "prompt":
        cmd_prompt(parsed.tier, parsed.route, parsed.provider)
    elif parsed.command == "status":
        cmd_status()
    elif parsed.command == "save":
        cmd_save()
    elif parsed.command == "log":
        cmd_log(parsed.n)
    elif parsed.command == "map":
        cmd_map()
    elif parsed.command == "lock":
        cmd_lock(parsed.workstream, parsed.owner, parsed.scope)
    elif parsed.command == "unlock":
        cmd_unlock(parsed.workstream, parsed.owner)
    elif parsed.command == "compact":
        cmd_compact(parsed.keep)
    elif parsed.command == "init":
        cmd_init(parsed.slug)
    elif parsed.command == "inject":
        cmd_inject(parsed.tool)
    elif parsed.command == "doctor":
        cmd_doctor()
    return 0


if __name__ == "__main__":
    sys.exit(main())
